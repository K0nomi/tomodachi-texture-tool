{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tomodachi Texture Tool",
  "version": "0.2.0",
  "identifier": "com.farbensplasch.ttt",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "",
        "width": 820,
        "height": 560,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"]
  }
}
